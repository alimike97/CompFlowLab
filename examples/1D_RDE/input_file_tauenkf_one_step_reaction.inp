# solver
solver_mode   = TAUENKF

# time discretization
dt            = 1e-8
num_steps     = 10002
time_scheme   = FDF

# space discretization
x_initial   = 0
x_final     = 0.288
cell_number = 2000

# inlet BC
rho_inlet         = periodic
vel_inlet         = periodic
press_inlet       = periodic
temp_inlet        = periodic
mass_frac_inlet   = periodic

# outlet BC
rho_outlet        = periodic
vel_outlet        = periodic
press_outlet      = periodic
temp_outlet       = periodic
mass_frac_outlet  = periodic


# Initial Condition
ic_path        = /Users/alish/GIT_FORK/CompFlowLab/examples/1D_RDE/IC_ramp_PR_2_2000_one_step_reaction.npy


# gas model
gas_model       = /Users/alish/GIT_FORK/CompFlowLab/examples/1D_RDE/chem_one_step_reaction.inp
flux_scheme     = 2nd Order Roe 
limiter	        = True
limiter_method  = minmod    
viscous	        = True
numpy_vector    = True

# Visualization
visual          = True
save_visual     = False
variable1 	    = Heat Release
variable2 	    = Pressure
variable3 	    = MF
variable4 	    = Temprature
update_interval = 1000

# Saving
save_interval   = 1000

# Profiling
profiling	    = False

# Injection
injection                 = True
injection_state_dir       = /Users/alish/GIT_FORK/CompFlowLab/examples/1D_RDE/Injection_Files/h2o2ar_phi_1_200ms_4atm_inject_prim_state.npy
rde                       = True
injector_face_area        = 0.05
injector_area_ratio       = 0.8
non_injection_portion     = 0.5
non_injection_tail_portion= 0.15

# ROM Setup
rom_method  		    = Galerkin
nl_rom_model            = rbf
arom_method		        = direct
pod_energy  		    = 99
hyper	    		    = True
hyper_method		    = FGS
sampling_rate           = 2
init_training_win 	    = 10
unsampled_update_freq 	= 15
training_data_dir       = C:\GIT_Fork\ROMify\examples\1D_RDE\FOM_results_11cycles
training_start_iter     = 50000
training_step_iter      = 10
training_end_iter       = 100000
rom_basis_generate       = False
rom_basis_dir            = C:\GIT_Fork\ROMify\examples\sod_shock_tube\precomputed_basis
sarom_training_step      = 100
sarom_srom_solver        = PROM
sarom_cumsum_tol         = 0.01
sarom_moving_avg_tol     = 0.01
# Restart 
arom_restart            = False

# Tau-space EnKF Setup (used by solver_mode = TAUENKF)
# ensemble: the IC profile shifted around the ring (uncertain wave position, in m)
# and with its ramp amplitude scaled (uncertain wave strength: deviation of rho, u, p, T
# from the fill state is multiplied by the amplitude); uniform ranges
num_ensmbl              = 40
ens_shift_range         = [-0.02, 0.02]
ens_amplitude_range     = [0.8, 1.2]
ens_seed                = 0
# truth/observation member; default is the median member (parameters closest to the
# ensemble median); it is taken out of the forecast ensemble and advanced without assimilation
# obs_member_index      = 20

# EnKF
# tau | physical
enkf_space              = tau
enkf_seed               = 0
# first assimilation iteration (one wave cycle is ~125000 iterations)
da_start_iter           = 2000
# iterations between assimilations
da_interval             = 2000
# primitive variables in the DA state (0 rho, 1 u, 2 p, 4 Y; T follows from p and rho)
da_state_var_index      = [0, 1, 2, 4]

# observations: pressure sensors around the annulus (truth member plus Gaussian noise)
obs_x_locations         = np.linspace(0, 0.288, 12, endpoint=False)
# observed primitive variables (must be in da_state_var_index)
obs_state_var_index     = [2]
# scalar or one value per observed variable (Pa)
obs_std                 = 5e4

# tau transformation
# periodic domain: each profile is opened at an anchor in its widest flat stretch (the fill
# region ahead of the detonation); tau_n_jumps further cuts give tau_n_jumps + 1 regions.
# The expansion tail starts right at the detonation front (no flat gap between them), so one region
tau_n_jumps             = [0, 0, 0, 0]
# tau samples per region
tau_n_levels            = 400
tau_regularization      = 1e-8
# cut detection: a cell face is flat if its (smoothed) |df| < tau_flat_tol * range(f);
# non-flat stretches are features unless they carry less than tau_feature_frac of the total variation
tau_flat_tol            = 1e-3
tau_feature_frac        = 0.01
# smoothing window (cells) of the gradient used for the cut detection
tau_smooth_cells        = 5
