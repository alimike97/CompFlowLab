# solver
solver_mode   = TAUENKF

# time discretization
dt            = 5e-5
# t = 0.15 at iteration 3000 (the driver runs iterations 0 .. num_steps-2)
num_steps     = 3002
time_scheme   = FDF

# space discretization
x_initial   = 0
x_final     = 1
cell_number = 500

# inlet BC
rho_inlet        = extrapolate
vel_inlet        = extrapolate
press_inlet      = extrapolate
temp_inlet       = extrapolate
mass_frac_inlet  = extrapolate

# outlet BC
rho_outlet        = extrapolate
vel_outlet        = extrapolate
press_outlet      = extrapolate
temp_outlet       = extrapolate
mass_frac_outlet  = extrapolate

# Initial Condition

# ic_path = ""

x_interval_ic = [[0,0.5],[0.5,1]]
rho_ic        = [1,0.125]
vel_ic        = [0.001,0.001]
press_ic      = [1,0.1]
temp_ic       = [300,300]
mass_frac_ic  = [[1.0, 0.0],[1.0, 0.0]]


# gas model
gas_model       = Air
flux_scheme     = 2nd Order Roe
# avoids oscillations that confuse the tau cuts
limiter	        = True
limiter_method  = minmod
viscous	        = False
numpy_vector    = True

# Visualization
visual          = False
save_visual     = False
variable1 	    = Density
variable2 	    = Pressure
variable3 	    = Velocity
variable4 	    = Temprature
update_interval = 100

# Saving
save_interval   = 100

# Profiling
profiling	    = False

# Injection
injection       = False

# ROM Setup
rom_method  		    = galerkin
nl_rom_model            = rbf
arom_method		        = direct
pod_energy  		    = 99.999
hyper	    		    = True
hyper_method		    = QDEIM
sampling_rate           = 10
init_training_win 	    = 10
unsampled_update_freq 	= 10

training_data_dir       = C:\GIT_Fork\ROMify\examples\sod_shock_tube\FOM_results
training_start_iter     = 0
training_step_iter      = 100
training_end_iter       = 5000

rom_basis_generate       = False
rom_basis_dir            = C:\GIT_Fork\ROMify\examples\sod_shock_tube\precomputed_basis

sarom_training_step      = 100
sarom_srom_solver        = PROM
sarom_cumsum_tol         = 0.01
sarom_moving_avg_tol     = 0.01

# Restart
arom_restart            = False

# Tau-space EnKF Setup (used by solver_mode = TAUENKF)
# ensemble: uncertain diaphragm location and left pressure (uniform ranges)
num_ensmbl              = 100
ens_x_diaphragm_range   = [0.40, 0.58]
ens_press_left_range    = [0.6, 1.8]
ens_seed                = 0
# truth/observation member; default is the median member (parameters closest to the
# ensemble median); it is taken out of the forecast ensemble and advanced without assimilation
# obs_member_index      = 50

# EnKF
# tau | physical
enkf_space              = tau
enkf_seed               = 0
# first assimilation iteration
da_start_iter           = 1000
# iterations between assimilations
da_interval             = 1000
# primitive variables in the DA state (0 rho, 1 u, 2 p)
da_state_var_index      = [0, 1, 2]

# observations: point sensors of the truth member plus Gaussian noise
obs_x_locations         = np.linspace(0.05, 0.95, 25)
# observed primitive variables (must be in da_state_var_index)
obs_state_var_index     = [2]
# scalar or one value per observed variable
obs_std                 = 0.02

# tau transformation
# per DA variable -> rho: contact + shock, u: shock, p: shock
tau_n_jumps             = [2, 1, 1]
# tau samples per region
tau_n_levels            = 200
tau_regularization      = 1e-8
# cut detection: a cell face is flat if its (smoothed) |df| < tau_flat_tol * range(f);
# non-flat stretches are features (rarefaction, contact, shock) unless they carry less
# than tau_feature_frac of the total variation of the profile; cuts go in the flat gaps between features
tau_flat_tol            = 1e-3
tau_feature_frac        = 0.01
# smoothing window (cells) of the gradient used for the cut detection
tau_smooth_cells        = 5
